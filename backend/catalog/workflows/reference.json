{
  "label": "Reference SDXL",
  "workflow": {
    "3": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {"text": "__PROMPT__", "clip": ["3", 1]}
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {"text": "", "clip": ["3", 1]}
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
    },
    "4": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 20,
        "cfg": 7,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1,
        "model": ["3", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {"samples": ["4", 0], "vae": ["3", 2]}
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {"filename_prefix": "orchestrator", "images": ["8", 0]}
    }
  }
}
