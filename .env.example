EXPOSE_HOST=127.0.0.1
PORT=8000
ADMIN_PASSWORD=
LOG_LEVEL=info
DATA_DIR=./data
OLLAMA_URL=http://127.0.0.1:11434
COMFYUI_URL=http://127.0.0.1:8188
# En Docker, le backend joint le service compose par defaut :
# COMFYUI_URL=http://comfyui:8188
# Pour un ComfyUI lance sur l'hote (hors Docker) :
# COMFYUI_URL=http://host.docker.internal:8188
# Options CLI ComfyUI (ex. GPU de moins de 6 Go de VRAM) :
# COMFYUI_CLI_ARGS=--lowvram
# Fernet master key; if empty, a 0600 key is generated under DATA_DIR/secrets/
ORCHESTRATOR_SECRET_KEY=
